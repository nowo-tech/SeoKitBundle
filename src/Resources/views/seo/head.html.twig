{# Override via templates/bundles/NowoSeoKitBundle/seo/head.html.twig #}
{#
    Set nowo_seo_kit.templates.head_includes_title to false (host override without <title>)
    when the layout owns the title block — see docs/CONFIGURATION.md.
#}
{% if seo_include_title|default(true) %}
<title>{{ seo.title }}</title>
{% endif %}
{% if seo.verification.google %}
<meta name="google-site-verification" content="{{ seo.verification.google }}">
{% endif %}
{% if seo.verification.bing %}
<meta name="msvalidate.01" content="{{ seo.verification.bing }}">
{% endif %}
{% if seo.description %}
<meta name="description" content="{{ seo.description }}">
{% endif %}
{% if seo.keywords %}
<meta name="keywords" content="{{ seo.keywords }}">
{% endif %}
{% if seo.author %}
<meta name="author" content="{{ seo.author }}">
{% endif %}
<meta name="robots" content="{{ seo.robots }}">
{% if seo.canonical %}
<link rel="canonical" href="{{ seo.canonical }}">
{% endif %}
{% for alt in seo.alternates %}
<link rel="alternate" hreflang="{{ alt.hreflang }}" href="{{ alt.url }}">
{% endfor %}
{% if seo.openGraph.enabled %}
<meta property="og:type" content="{{ seo.openGraph.type }}">
<meta property="og:title" content="{{ seo.openGraph.title }}">
{% if seo.openGraph.description %}
<meta property="og:description" content="{{ seo.openGraph.description }}">
{% endif %}
{% if seo.openGraph.url %}
<meta property="og:url" content="{{ seo.openGraph.url }}">
{% endif %}
{% if seo.openGraph.site_name %}
<meta property="og:site_name" content="{{ seo.openGraph.site_name }}">
{% endif %}
{% if seo.openGraph.locale %}
<meta property="og:locale" content="{{ seo.openGraph.locale|replace({'-': '_'}) }}">
{% endif %}
{% for alternate in seo.openGraph.locale_alternates|default([]) %}
<meta property="og:locale:alternate" content="{{ alternate }}">
{% endfor %}
{% if seo.openGraph.image %}
<meta property="og:image" content="{{ seo.openGraph.image }}">
{% if seo.openGraph.image_width %}
<meta property="og:image:width" content="{{ seo.openGraph.image_width }}">
{% endif %}
{% if seo.openGraph.image_height %}
<meta property="og:image:height" content="{{ seo.openGraph.image_height }}">
{% endif %}
<meta property="og:image:alt" content="{{ seo.openGraph.image_alt|default(seo.openGraph.title) }}">
{% endif %}
{% endif %}
{% if seo.twitter.enabled %}
<meta name="twitter:card" content="{{ seo.twitter.card }}">
<meta name="twitter:title" content="{{ seo.twitter.title }}">
{% if seo.twitter.description %}
<meta name="twitter:description" content="{{ seo.twitter.description }}">
{% endif %}
{% if seo.twitter.image %}
<meta name="twitter:image" content="{{ seo.twitter.image }}">
{% endif %}
{% if seo.twitter.site %}
<meta name="twitter:site" content="{{ seo.twitter.site }}">
{% endif %}
{% if seo.twitter.creator %}
<meta name="twitter:creator" content="{{ seo.twitter.creator }}">
{% endif %}
{% endif %}
{% if seo.jsonLd.enabled and (seo.jsonLd.json or seo.jsonLd.document is not null or seo.jsonLd.graph is not empty) %}
<script type="application/ld+json"{% if csp_nonce is defined and csp_nonce %} nonce="{{ csp_nonce }}"{% endif %}>{% if seo.jsonLd.json %}{{ seo.jsonLd.json|raw }}{% elseif seo.jsonLd.document is not null %}{{ seo.jsonLd.document|json_encode|raw }}{% else %}{{ {'@context': 'https://schema.org', '@graph': seo.jsonLd.graph}|json_encode|raw }}{% endif %}</script>
{% endif %}
