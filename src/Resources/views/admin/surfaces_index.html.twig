{#
  Surfaces SEO list (REQ-UI-003): UiKit list scaffold.
  View model: page (View\ListPage, SeoKitPages::surfacesPage()): header nowo_seo_kit.admin.surfaces.title / .intro,
  admin navigation as header tabs; filters = the GET locale switcher (SeoSurfaceLocaleFilterType, `?locale=`); one
  row per audit subject: id, surface, path, title, problems (audit codes), has_override; row action Edit (GET);
  EmptyState nowo_seo_kit.admin.surfaces.empty_title / .empty; caption = the locale.
  Extra variables (kept for web_ui.templates overrides): locale, locales, rows (list<SeoAuditRow>), site_indexable.
  Data blocks: nowo_ui_list_row (cells: problems as badges with translated labels), nowo_ui_content prepends the
  site-wide noindex notice (flash_info slot).
#}
{% extends '@NowoUiKit/page/list.html.twig' %}

{% block nowo_ui_content %}
    {% if not site_indexable %}
        <div class="{{ nowo_ui_class('flash_info', page.bundle) }}" role="status" data-testid="seo-kit-surfaces-site-noindex">{{ 'nowo_seo_kit.admin.surfaces.site_noindex'|trans({}, 'NowoSeoKitBundle') }}</div>
    {% endif %}
    {{ parent() }}
{% endblock %}

{% block nowo_ui_list_row %}
    {%- set _b = page.bundle -%}
    <td class="{{ nowo_ui_class('table_cell', _b) }}" data-label="{{ 'nowo_seo_kit.admin.surfaces.column.surface'|trans({}, 'NowoSeoKitBundle') }}" data-required="1">
        <code class="{{ nowo_ui_class('code', _b) }}">{{ row.surface }}</code>
        {% if row.has_override %}
            <span class="{{ nowo_ui_class('badge_info', _b) }}">{{ 'nowo_seo_kit.admin.surfaces.override'|trans({}, 'NowoSeoKitBundle') }}</span>
        {% endif %}
    </td>
    <td class="{{ nowo_ui_class('table_cell', _b) }}" data-label="{{ 'nowo_seo_kit.admin.surfaces.column.path'|trans({}, 'NowoSeoKitBundle') }}" data-nowo-ui-priority="2"><code class="{{ nowo_ui_class('code', _b) }}">{{ row.path }}</code></td>
    <td class="{{ nowo_ui_class('table_cell', _b) }}{{ row.title is same as('') ? ' ' ~ nowo_ui_class('table_cell_muted', _b) }}" data-label="{{ 'nowo_seo_kit.admin.surfaces.column.title'|trans({}, 'NowoSeoKitBundle') }}">{{ row.title is same as('') ? '—' : row.title }}</td>
    <td class="{{ nowo_ui_class('table_cell', _b) }}" data-label="{{ 'nowo_seo_kit.admin.surfaces.column.problems'|trans({}, 'NowoSeoKitBundle') }}">
        {% for problem in row.problems %}
            <span class="{{ nowo_ui_class(problem == 'published_but_noindex' ? 'badge_danger' : 'badge_warning', _b) }}" data-testid="seo-kit-problem-{{ problem }}">{{ ('nowo_seo_kit.admin.surfaces.problem.' ~ problem)|trans({}, 'NowoSeoKitBundle') }}</span>
        {% else %}
            <span class="{{ nowo_ui_class('badge_success', _b) }}">{{ 'nowo_seo_kit.admin.surfaces.no_problems'|trans({}, 'NowoSeoKitBundle') }}</span>
        {% endfor %}
    </td>
{% endblock %}
