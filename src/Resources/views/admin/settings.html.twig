{#
  Site SEO settings (REQ-UI-003): UiKit form scaffold.
  View model: page (View\FormPage, SeoKitPages::settingsPage()): header nowo_seo_kit.admin.settings.title / .intro,
  admin navigation as header tabs (SEO settings | Page SEO when both pages are enabled); form = SeoSiteSettingsType;
  submit nowo_seo_kit.admin.save; formThemes = web_ui.form_themes.
  Extra variables (kept for web_ui.templates overrides): form, settings, enabled_locales, default_locale.
  Data blocks: nowo_ui_form_body — REQ-TWIG-003 child loop; the per-locale wording (`defaultTitle_<locale>`,
  `homeTitle_<locale>`, `defaultDescription_<locale>`, `organisationDescription_<locale>`) renders right before
  `organisationLegalName` as one tab per enabled locale through the FormKit `locale_tabs` include (UiKit
  `locale_tabs` partial): DOM ids `tab-nowo-seo-kit-settings-wording-<locale>` (tab) and
  `tab-nowo-seo-kit-settings-wording-<locale>-panel` (panel); without JavaScript every locale stays visible as a
  stacked fieldset. nowo_ui_content prepends the noindex notice (flash_warning slot).
#}
{% extends '@NowoUiKit/page/form.html.twig' %}

{% block nowo_ui_content %}
    {% if not settings.indexable %}
        <div class="{{ nowo_ui_class('flash_warning', page.bundle) }}" role="status" data-testid="seo-kit-settings-noindex">{{ 'nowo_seo_kit.admin.settings.noindex_warning'|trans({}, 'NowoSeoKitBundle') }}</div>
    {% endif %}
    {{ parent() }}
{% endblock %}

{% block nowo_ui_form_body %}
    {% for child in form %}
        {% if not child.rendered %}
            {% if child.vars.name == 'organisationLegalName' %}
                <fieldset class="{{ nowo_ui_class('section', page.bundle) }}" data-testid="seo-kit-settings-wording">
                    <legend>{{ 'nowo_seo_kit.admin.settings.section.wording'|trans({}, 'NowoSeoKitBundle') }}</legend>
                    {{ include('@NowoFormKitBundle/form/_locale_tabs.html.twig', {
                        field: form,
                        fields: form.vars.localised_fields,
                        locales: enabled_locales,
                        default_locale: default_locale,
                        tabs_id: 'nowo-seo-kit-settings-wording',
                        testid: 'nowo-seo-kit-settings-wording',
                        bundle: 'SeoKitBundle',
                    }, with_context: false) }}
                </fieldset>
                <h2 class="{{ nowo_ui_class('card_title', page.bundle) }}">{{ 'nowo_seo_kit.admin.settings.section.organisation'|trans({}, 'NowoSeoKitBundle') }}</h2>
            {% endif %}
            {{ form_row(child) }}
        {% endif %}
    {% endfor %}
{% endblock %}
