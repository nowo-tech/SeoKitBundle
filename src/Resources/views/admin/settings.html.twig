{#
  Override in the host for branded chrome. Default is a minimal functional layout.

  The per-locale wording (`defaultTitle_<locale>`, `homeTitle_<locale>`, `defaultDescription_<locale>`,
  `organisationDescription_<locale>`) renders as one tab per enabled locale through the FormKit `locale_tabs` include
  (UiKit `locale_tabs` partial when nowo-tech/ui-kit-bundle is registered): DOM ids `tab-nowo-seo-kit-settings-wording-<locale>`
  (tab) and `tab-nowo-seo-kit-settings-wording-<locale>-panel` (panel). Without JavaScript every locale stays visible
  as a stacked fieldset.
#}
<!DOCTYPE html>
<html lang="{{ default_locale|default('en') }}">
<head>
    <meta charset="utf-8">
    <title>{{ 'nowo_seo_kit.admin.settings.title'|trans({}, 'NowoSeoKitBundle') }}</title>
    {% if nowo_form_kit_ui_kit_locale_tabs() %}
        <link rel="stylesheet" href="{{ asset('css/nowo-ui.css', 'nowo_ui_kit') }}">
        <script src="{{ asset('js/nowo-ui-tabs.js', 'nowo_ui_kit') }}" defer></script>
    {% endif %}
</head>
<body>
<main>
    <h1>{{ 'nowo_seo_kit.admin.settings.title'|trans({}, 'NowoSeoKitBundle') }}</h1>
    {{ include('@NowoSeoKitBundle/admin/_flashes.html.twig') }}
    <p>{{ 'nowo_seo_kit.admin.settings.intro'|trans({}, 'NowoSeoKitBundle') }}</p>

    {% if not settings.indexable %}
        <p role="status"><strong>{{ 'nowo_seo_kit.admin.settings.noindex_warning'|trans({}, 'NowoSeoKitBundle') }}</strong></p>
    {% endif %}

    {{ form_start(form) }}
        {{ form_row(form.siteName) }}
        {{ form_row(form.titleTemplate) }}
        {{ form_row(form.indexable) }}
        {{ form_row(form.defaultRobots) }}
        {{ form_row(form.defaultOpenGraphImage) }}
        {{ form_row(form.twitterSite) }}

        <h2>{{ 'nowo_seo_kit.admin.settings.section.wording'|trans({}, 'NowoSeoKitBundle') }}</h2>
        {{ include('@NowoFormKitBundle/form/_locale_tabs.html.twig', {
            field: form,
            fields: form.vars.localised_fields,
            locales: enabled_locales,
            default_locale: default_locale,
            tabs_id: 'nowo-seo-kit-settings-wording',
            testid: 'nowo-seo-kit-settings-wording',
            bundle: 'SeoKitBundle',
        }, with_context: false) }}

        <h2>{{ 'nowo_seo_kit.admin.settings.section.organisation'|trans({}, 'NowoSeoKitBundle') }}</h2>
        {{ form_row(form.organisationLegalName) }}
        {{ form_row(form.organisationLogo) }}
        {{ form_row(form.contactEmail) }}
        {{ form_row(form.contactPhone) }}
        {{ form_row(form.streetAddress) }}
        {{ form_row(form.postalCode) }}
        {{ form_row(form.addressLocality) }}
        {{ form_row(form.addressRegion) }}
        {{ form_row(form.addressCountry) }}
        {{ form_row(form.socialProfilesText) }}
        {{ form_row(form.googleSiteVerification) }}
        {{ form_row(form.bingSiteVerification) }}

        <button type="submit">{{ 'nowo_seo_kit.admin.save'|trans({}, 'NowoSeoKitBundle') }}</button>
    {{ form_end(form) }}
</main>
</body>
</html>
