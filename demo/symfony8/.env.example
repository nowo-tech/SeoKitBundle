# APP_ENV: Symfony environment (dev/test/prod). In demos it is usually `dev`.
APP_ENV=dev

# APP_DEBUG: enable/disable detailed debug output (usually `1` in dev).
APP_DEBUG=1

# FRANKENPHP_MODE: FrankenPHP runtime mode — `classic` (one process per request) or `worker` (long-lived workers).
# Default: worker. Set classic for per-request PHP / easier hot-reload. Recreate with `docker compose up -d` after change.
FRANKENPHP_MODE=worker

# APP_SECRET: secret used for signing/tokens. Must be safe (use a local-only value).
APP_SECRET=change_this_secret_key_to_a_random_value

# PORT: host port published by Docker Compose for this demo.
PORT=8050

# DEFAULT_URI: public base URL used by the demo (canonical / absolute links).
DEFAULT_URI=http://localhost:8050
