{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell (@NowoUiKit/demo_platform/layout.html.twig):
    the same top bar, aside, content width, theme and footer as every other nowo-tech bundle demo. This file only
    declares the demo (nowo_ui_demo_platform). nowo_seo_head() prints the SEO tags; the <title> is the layout's own
    (templates.head_includes_title: false), fed by the SEO metadata. The language pills use the hreflang alternates
    of the current page (the localized SEO URLs), not the route with another _locale. -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set _seo = nowo_seo_metadata() %}
{% set _locale = app.request.locale|default('en') %}
{% set _blog_slugs = { en: 'hello-world', es: 'hola-mundo', fr: 'bonjour-le-monde' } %}
{% set _alternates = [] %}
{% for alt in _seo.alternates %}
    {% if alt.hreflang != 'x-default' %}
        {% set _alternates = _alternates|merge([{code: alt.locale, label: alt.locale|upper, href: alt.url}]) %}
    {% endif %}
{% endfor %}
{% set nowo_ui_demo_platform = {
    bundle: 'SEO Kit',
    home_route: 'app_home',
    home_params: {_locale: _locale},
    repository: 'https://github.com/nowo-tech/SeoKitBundle',
    translation_domain: false,
    locales: _alternates,
    footer_links: [{label: 'Sitemap', href: '/sitemap.xml'}, {label: 'Robots', href: '/robots.txt'}],
    nav: [
        {label: 'Home', route: 'app_home', params: {_locale: _locale}, section: 'Demo'},
        {label: 'About', route: 'app_about', params: {_locale: _locale}, section: 'Demo'},
        {label: 'Blog sample', route: 'app_blog_show', params: {_locale: _locale, slug: _blog_slugs[_locale]|default('hello-world')}, section: 'Demo'},
        {label: 'Dashboard', route: 'admin_seo_dashboard', section: 'SEO admin'},
        {label: 'Pages', route: 'admin_seo_pages', active: ['admin_seo_pages', 'admin_seo_page_*'], section: 'SEO admin'},
        {label: 'Slug routes', route: 'admin_seo_slug_routes', active: ['admin_seo_slug_routes', 'admin_seo_slug_route_*'], section: 'SEO admin'},
        {label: 'Slugs / URLs', route: 'admin_seo_slugs', active: ['admin_seo_slugs', 'admin_seo_slug_new', 'admin_seo_slug_edit', 'admin_seo_slug_delete'], section: 'SEO admin'},
        {label: 'Site settings', route: 'admin_seo_settings_preview', section: 'SEO admin'},
    ],
} %}

{% block nowo_ui_document_title %}{% block title %}{{ nowo_seo_metadata().title }}{% endblock %}{% endblock %}

{% block nowo_ui_head %}
    {{ nowo_seo_head() }}
{% endblock %}
