{% extends 'admin/seo/layout.html.twig' %}

{% block title %}SEO Admin · {{ is_new ? 'New slug' : 'Edit slug' }}{% endblock %}
{% block admin_intro %}Canonical slug key + per-locale translated <code>slug</code> / optional absolute <code>path</code>.{% endblock %}

{% block body %}
    {% if slug_urls is not empty %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Resolved SEO URLs', kind: 'list', slug_urls: slug_urls} %}
            {% block section_body %}{{ include('admin/seo/_urls.html.twig', {urls: slug_urls}) }}{% endblock %}
        {% endembed %}
    {% endif %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Definition', kind: 'form', form: form} %}
        {% block section_body %}
            {{ form_start(form, {attr: {id: 'seo-form'}}) }}
                {{ include('admin/seo/_form_fields.html.twig', {form: form}) }}
            {{ form_end(form) }}
        {% endblock %}
        {% block section_footer %}
            <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('admin_seo_slugs') }}">Cancel</a>
            <button class="nowo-ui-btn nowo-ui-btn--primary" type="submit" form="seo-form">Save</button>
        {% endblock %}
    {% endembed %}
{% endblock %}
