{% extends 'admin/seo/layout.html.twig' %}

{% block title %}SEO Admin · Slugs / URLs{% endblock %}
{% block admin_intro %}Per-slug SEO + translated URL slugs (<code>slugs.*</code>).{% endblock %}
{% block admin_toolbar %}<a class="nowo-ui-btn nowo-ui-btn--primary" href="{{ path('admin_seo_slug_new') }}">New slug</a>{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Slugs', kind: 'table', empty: slugs is empty, state_message: 'No slugs configured.', slugs: slugs, slug_urls: slug_urls, delete_forms: delete_forms} %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <thead><tr><th scope="col">Route / slug</th><th scope="col">Meta</th><th scope="col">SEO URLs</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
                <tbody>
                    {% set _n = 0 %}
                    {% for route, bySlug in slugs %}
                        {% for slug, cfg in bySlug %}
                            {% set _n = _n + 1 %}
                            <tr>
                                <th scope="row"><code>{{ route }}</code><br><code>{{ slug }}</code></th>
                                <td>
                                    {{ cfg.title|default('—') }}<br>
                                    <span class="nowo-ui-muted">sitemap: {{ cfg.in_sitemap|default(true) ? 'yes' : 'no' }} · noindex: {{ cfg.noindex|default(false) ? 'yes' : 'no' }}</span>
                                </td>
                                <td class="nowo-ui-cell--wrap">{{ include('admin/seo/_urls.html.twig', {urls: slug_urls[route][slug]|default({})}) }}</td>
                                <td>
                                    <div class="nowo-ui-row-actions">
                                        <a class="nowo-ui-btn nowo-ui-btn--outline nowo-ui-btn--sm" href="{{ path('admin_seo_slug_edit', {route: route, slug: slug}) }}">Edit</a>
                                        {{ include('admin/seo/_delete.html.twig', {form: delete_forms[route][slug], dialog_id: 'seo-delete-slug-' ~ _n, title: 'Delete slug ' ~ slug ~ '?', message: 'The slug entry is removed from the SEO configuration.'}) }}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}
{% endblock %}
