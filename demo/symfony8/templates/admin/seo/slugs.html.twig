{% extends 'admin/seo/layout.html.twig' %}

{% block title %}SEO Admin · Slugs / URLs{% endblock %}

{% block body %}
    <div class="nowo-ui-toolbar">
        <p class="nowo-ui-muted">Per-slug SEO + translated URL slugs (<code>slugs.*</code>).</p>
        <a class="nowo-ui-btn nowo-ui-btn--primary" href="{{ path('admin_seo_slug_new') }}">New slug</a>
    </div>
    <table class="nowo-ui-table">
        <thead>
            <tr>
                <th>Route / slug</th>
                <th>Meta</th>
                <th>SEO URLs</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for route, bySlug in slugs %}
                {% for slug, cfg in bySlug %}
                    <tr>
                        <td>
                            <code>{{ route }}</code><br>
                            <code>{{ slug }}</code>
                        </td>
                        <td>
                            {{ cfg.title|default('—') }}<br>
                            <span class="nowo-ui-muted">
                                sitemap: {{ cfg.in_sitemap|default(true) ? 'yes' : 'no' }}
                                · noindex: {{ cfg.noindex|default(false) ? 'yes' : 'no' }}
                            </span>
                        </td>
                        <td>
                            <ul class="nowo-ui-list">
                                {% for locale, url in slug_urls[route][slug]|default({}) %}
                                    <li><code>{{ locale }}</code>:
                                        {% if url %}<a href="{{ url }}">{{ url }}</a>{% else %}—{% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                        </td>
                        <td class="nowo-ui-table__actions">
                            <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('admin_seo_slug_edit', {route: route, slug: slug}) }}">Edit</a>
                            {{ form_start(delete_forms[route][slug], {attr: {onsubmit: 'return confirm(\'Delete slug ' ~ slug ~ '?\');'}}) }}
                                {% for child in delete_forms[route][slug] %}
                                    {% if not child.rendered %}
                                        {{ form_row(child) }}
                                    {% endif %}
                                {% endfor %}
                                <button class="nowo-ui-btn nowo-ui-btn--danger" type="submit">Delete</button>
                            {{ form_end(delete_forms[route][slug]) }}
                        </td>
                    </tr>
                {% endfor %}
            {% else %}
                <tr><td colspan="4">No slugs configured.</td></tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
