{#- Admin shell of the demo CRUD: the demo shell with a page header (title, intro, toolbar). The admin sub-menu is the
    "SEO admin" group of the shell aside (base.html.twig). Pages fill the blocks admin_intro and admin_toolbar. -#}
{% extends 'base.html.twig' %}

{% block title %}SEO Admin{% endblock %}

{% block admin_intro %}Demo CRUD · config + SEO URL definitions{% endblock %}
{% block admin_toolbar %}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: block('title'), intro: block('admin_intro'), toolbar: block('admin_toolbar')}) }}
{% endblock %}
