{% extends 'admin/seo/layout.html.twig' %}

{% block title %}SEO Admin · {{ is_new ? 'New slug route' : 'Edit slug route' }}{% endblock %}
{% block admin_intro %}Defines <code>path_pattern</code> / title templates used by slug SEO URLs.{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Definition', kind: 'form', form: form} %}
        {% block section_body %}
            {{ form_start(form, {attr: {id: 'seo-form'}}) }}
                {{ include('admin/seo/_form_fields.html.twig', {form: form}) }}
            {{ form_end(form) }}
        {% endblock %}
        {% block section_footer %}
            <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('admin_seo_slug_routes') }}">Cancel</a>
            <button class="nowo-ui-btn nowo-ui-btn--primary" type="submit" form="seo-form">Save</button>
        {% endblock %}
    {% endembed %}
{% endblock %}
