{% extends 'admin/seo/layout.html.twig' %}

{% block title %}SEO Admin · {{ is_new ? 'New slug route' : 'Edit slug route' }}{% endblock %}

{% block body %}
    <p class="nowo-ui-muted">Defines <code>path_pattern</code> / title templates used by slug SEO URLs.</p>

    {{ form_start(form) }}
        {% for child in form %}
            {% if not child.rendered %}
                {% if child.vars.name == 'locales' %}
                    {% for locale_form in child %}
                        <fieldset>
                            <legend>{{ locale_form.vars.label }}</legend>
                            {% for field in locale_form %}
                                {% if not field.rendered %}
                                    {{ form_row(field) }}
                                {% endif %}
                            {% endfor %}
                        </fieldset>
                    {% endfor %}
                    {% do child.setRendered %}
                {% else %}
                    {{ form_row(child) }}
                {% endif %}
            {% endif %}
        {% endfor %}

        <div class="nowo-ui-form__actions">
            <button class="nowo-ui-btn nowo-ui-btn--primary" type="submit">Save</button>
            <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('admin_seo_slug_routes') }}">Cancel</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
