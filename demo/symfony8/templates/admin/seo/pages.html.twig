{% extends 'admin/seo/layout.html.twig' %}

{% block title %}SEO Admin · Pages{% endblock %}
{% block admin_intro %}Static route SEO (<code>pages.*</code>) with locale paths for hreflang / sitemap.{% endblock %}
{% block admin_toolbar %}<a class="nowo-ui-btn nowo-ui-btn--primary" href="{{ path('admin_seo_page_new') }}">New page</a>{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Pages', kind: 'table', empty: pages is empty, state_message: 'No pages configured.', pages: pages, page_urls: page_urls, delete_forms: delete_forms} %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <thead><tr><th scope="col">Route</th><th scope="col">Default path</th><th scope="col">SEO URLs</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
                <tbody>
                    {% for route, page in pages %}
                        <tr>
                            <th scope="row"><code>{{ route }}</code><br><span class="nowo-ui-muted">{{ page.title|default('') }}</span></th>
                            <td><code>{{ page.path|default('—') }}</code></td>
                            <td class="nowo-ui-cell--wrap">{{ include('admin/seo/_urls.html.twig', {urls: page_urls[route]|default({})}) }}</td>
                            <td>
                                <div class="nowo-ui-row-actions">
                                    <a class="nowo-ui-btn nowo-ui-btn--outline nowo-ui-btn--sm" href="{{ path('admin_seo_page_edit', {route: route}) }}">Edit</a>
                                    {{ include('admin/seo/_delete.html.twig', {form: delete_forms[route], dialog_id: 'seo-delete-page-' ~ loop.index, title: 'Delete page ' ~ route ~ '?', message: 'The page entry is removed from the SEO configuration.'}) }}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}
{% endblock %}
