{% extends 'base.html.twig' %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'SEO Kit Demo', intro: 'Multilingual SEO with pages, slug routes, and configured slugs.'}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Language switch', kind: 'content'} %}
        {% block section_body %}
            <p>Use the language switch (EN / ES / FR) to change <code>_locale</code> and the localized path for the current page.</p>
        {% endblock %}
    {% endembed %}
{% endblock %}
