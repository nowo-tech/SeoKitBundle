{% extends 'base.html.twig' %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: title}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Slug', kind: 'detail', slug: slug} %}
        {% block section_body %}
            <p>Slug: <code>{{ slug }}</code></p>
            <p>SEO layers: slug_routes + slugs configuration.</p>
        {% endblock %}
    {% endembed %}
{% endblock %}
